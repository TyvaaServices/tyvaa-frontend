# Environment Variables for Different Builds
# Copy this file to .env.development, .env.staging, .env.production

# CinetPay Configuration
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_NOTIFY_URL=http://localhost:3000/api/v1/payments/notify

# App Environment
APP_ENV=development

# Backend API
API_BASE_URL=http://localhost:3000

# Debug settings
DEBUG_MODE=true
